{
  "app-id": "io.github.denysmb.unify",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "base": "io.qt.qtwebengine.BaseApp",
  "base-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "unify",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--share=network",
    "--socket=pulseaudio",
    "--device=all",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--own-name=org.mpris.MediaPlayer2.chromium.*",
    "--filesystem=xdg-download",
    "--env=QTWEBENGINEPROCESS_PATH=/app/bin/QtWebEngineProcess",
    "--env=QTWEBENGINE_CHROMIUM_FLAGS=--autoplay-policy=no-user-gesture-required --enable-features=WebRTCPipeWireCapturer --enable-widevine-cdm"
  ],
  "cleanup": ["/app/cleanup-BaseApp.sh"],
  "modules": [
